# Copy this file to .env and fill in real values. Never commit the real .env.

# --- Database ---
POSTGRES_USER=review_intel
POSTGRES_PASSWORD=review_intel_pw
POSTGRES_DB=review_intel
# When running the backend OUTSIDE docker-compose (e.g. local dev), point at localhost:
DATABASE_URL=postgresql+asyncpg://review_intel:review_intel_pw@localhost:5432/review_intel

# --- Vector DB ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=review_embeddings

# --- Cache / task queue ---
REDIS_URL=redis://localhost:6379/0

# --- Embeddings & LLM ---
# We use a local sentence-transformers model by default (no API key needed) for embeddings.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# LLM provider for topic labeling / summaries / Ask-AI. Fill in whichever you use.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- App ---
ENVIRONMENT=development
SECRET_KEY=change_me_to_a_random_secret
LOG_LEVEL=INFO
